{
  "name": "wonderlane-tutor",
  "main": "cloudflare/app-worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ENABLE_ACCOUNTS": "false",
    "ENABLE_BILLING": "false"
  },
  "workers_dev": true,
  "triggers": {"crons": ["0 8 * * *"]},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wonderlane-family",
      "database_id": "af1f6e88-685d-45cd-89d9-5c39208a0de6"
    }
  ]
}
