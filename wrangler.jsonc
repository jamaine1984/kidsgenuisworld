{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kid-genius-world",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-04-25",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_CACHE",
      "bucket_name": "kid-genius-world-media-cache"
    }
  ],
  "vars": {
    "ELEVENLABS_VOICE_ID": "JBFqnCBsd6RMkjVDRZzb",
    "ELEVENLABS_MODEL_ID": "eleven_flash_v2_5"
  },
  // Required before Stripe billing works:
  // wrangler secret put STRIPE_SECRET_KEY
  // wrangler secret put FIREBASE_WEB_API_KEY
  // Add STRIPE_MONTHLY_PRICE_ID here after creating a recurring Stripe Price.
  "observability": {
    "enabled": true
  }
}
